# Copy to .env (never commit it). All variables are optional.
IMPORTKIT_ENVIRONMENT=development        # development | test | production (production enables HSTS)
IMPORTKIT_HOST=127.0.0.1
IMPORTKIT_PORT=3205
# SQLAlchemy URL. Default: sqlite:///data/importkit.sqlite
# PostgreSQL: postgresql+psycopg://user:pass@host:5432/importkit (install extra: uv sync --extra postgres)
IMPORTKIT_DATABASE_URL=
IMPORTKIT_AUTO_MIGRATE=false             # run "alembic upgrade head" on startup
IMPORTKIT_MAX_UPLOAD_BYTES=800000
IMPORTKIT_MAX_ROWS=10000
IMPORTKIT_ALLOW_TEST_EMAIL_DOMAINS=false # accept addresses on the reserved .test TLD
# Comma-separated explicit origins allowed to call the API cross-origin (no "*").
IMPORTKIT_CORS_ORIGINS=
# Comma-separated CSP frame-ancestors sources for embedding, e.g. 'self',https://app.example.com
IMPORTKIT_FRAME_ANCESTORS='self'
IMPORTKIT_RATE_LIMIT_WRITES=30           # write requests per window per client; 0 disables
IMPORTKIT_RATE_LIMIT_WINDOW_SECONDS=60
IMPORTKIT_ENABLE_DOCS=true               # /docs, /redoc, /openapi.json
IMPORTKIT_LOG_LEVEL=INFO
IMPORTKIT_LOG_FORMAT=json                # json | console
